function[A1,b1]= pivoting(A1,b1,i) %i=1
[n,n]=size(A1)%3 3
p=i;%p=1
big=abs(A1(i,i))
disp('Before the pivoting')
A1
% 2 5 8
% 4 6 2
% 7 2 6
disp('After pivoting')
for j=i+1:n 
    dummy=abs(A1(j,i));
    if dummy>big
        big=dummy;
        p=j;
    end
end 
    if p~=i 
        %for k=i:n
            dummy=A1(i,:); 
            A1(i,:)=A1(p,:);
            A1(p,:)=dummy;
        %end
        dummy=b1(i); 
        b1(i)=b1(p);
        b1(p)=dummy;
    end
    
    A1
    b1
end

